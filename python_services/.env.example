# Must match VIDEO_PYTHON_TOKEN in the Laravel .env
API_TOKEN=change-me

# Shared with Laravel (relative paths are resolved from this folder)
LARAVEL_STORAGE_PATH=../storage/app/private
# Same database as Laravel (mysql or sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prgram_vid
DB_USERNAME=root
DB_PASSWORD=
# Only used when DB_CONNECTION=sqlite
DB_PATH=../database/database.sqlite

VIDEO_FPS=30
